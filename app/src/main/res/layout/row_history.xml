<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. 顶栏：分类标签 + 物品名称 + 记录时间 (清晰从容，绝不换行重叠) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/category_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数码"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_cat_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:maxLines="1"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="台式电脑"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 时间戳：固定单行，靠右对齐 -->
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-08-19 00:43"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:singleLine="true"
                android:maxLines="1"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 2. 主体栏：+ / - 状态圆形徽章 + 数量/天数/日均 + 金额与操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- + / - 状态圆形徽章 -->
            <TextView
                android:id="@+id/badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar" />

            <!-- 数量、拥有天数、日均花费描述 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qtyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1台 · 拥有 167 天 · 日均 ¥32.93"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- 右侧：金额与操作按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ ¥5500.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/editBtn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="编辑"
                        android:padding="4dp" />

                    <ImageView
                        android:id="@+id/deleteBtn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/text_hint"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="删除"
                        android:padding="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 3. 空间与放置位置条 (若已填写) -->
        <LinearLayout
            android:id="@+id/location_badge_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_changelog_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/location_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 自己的家 · 次卧"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/btn_loc_history_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轨迹 ▾"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_chip_inactive" />
        </LinearLayout>

        <!-- 4. 备注信息卡片 (若有) -->
        <TextView
            android:id="@+id/notes_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 备注: 京东组装件"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_qty"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>