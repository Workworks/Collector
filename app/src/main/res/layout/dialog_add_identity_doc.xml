<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🪪"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_add_doc_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登记家庭成员证照"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="身份证、护照、户口本、结婚证、房产证与合同"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_add_doc"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 成员归属与证件类型 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="归属成员与证件类型："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_select_member"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical"
                    android:text="👨 成员: 本人"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_select_doc_type"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical"
                    android:text="🪪 身份证"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- 2. 证件持有人姓名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="证件持有人姓名："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_doc_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="如：张三、李四"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- 3. 证件号码 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="证件号码 / 统一代码："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_doc_number"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="如 18位身份证号 / 护照号"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- 4. 有效期截止日 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有效期截止日 (提前预警换证)："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_doc_expiry_picker"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:text="📅 设定有效期截止日 (或长期有效)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- 5. 签发机关与备注 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="签发机关与备注："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_doc_authority"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="签发机关 (选填，如 XX市公安局)"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_doc_notes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_input_box"
                android:padding="10dp"
                android:gravity="top|start"
                android:hint="备注信息 (如 原件存放于主卧床头保险盒...)"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textMultiLine" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_doc"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_doc"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="🪪 保存证照档案"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
