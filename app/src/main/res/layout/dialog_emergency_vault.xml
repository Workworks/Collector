<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🚨"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="家庭应急防灾与生命线舱"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="四大避难专包 · 黄金动线定位 · 时效轮换生命线"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_emergency"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="➕ 备入物资"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 统计卡片条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_changelog_box"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常备物资"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_total_emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 件"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/card_border"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待轮换/临期"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_expiring_emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 项"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/card_border"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已失效/过期"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_expired_emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 项"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/danger"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 搜索栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search_emergency"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_box"
            android:hint="🔍 搜索应急物资、收纳位置或使用要领..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />
    </FrameLayout>

    <!-- 场景包分类 Tab -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_emergency_kits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kit_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:checked="true"
                android:text="全部物资"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kit_earthquake"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🏠 地震避险72h"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kit_fire"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔥 火灾逃生"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kit_car"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🚗 车载救援"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kit_flood"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🌧️ 暴雨防汛"
                android:textSize="12sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 列表容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_emergency"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- 空态提示 -->
        <LinearLayout
            android:id="@+id/layout_emergency_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前场景包暂无应急物资记录"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击右上角「➕ 备入物资」建立家庭防灾生命线"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部关闭按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_emergency_vault"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="关闭应急舱"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:cornerRadius="10dp" />

</LinearLayout>
