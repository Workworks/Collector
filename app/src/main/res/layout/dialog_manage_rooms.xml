<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- 顶部操作条（添加房间 + 恢复推荐） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_room"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ 新增自定义房间"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="10dp" />

        <TextView
            android:id="@+id/btn_reset_rooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恢复推荐"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_room_manage_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提示：可自由添加阳台、书房、衣帽间等房间，平面图将实时联动呈现"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border" />

    <!-- 房间列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/room_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:overScrollMode="never" />

</LinearLayout>
