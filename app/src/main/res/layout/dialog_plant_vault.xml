<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🪴"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="家庭绿植花卉与水肥养护舱"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="绿植花卉档案 · 水肥日历排期 · 一键浇水/施肥打卡"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_plant"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="➕ 添入绿植"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 统计卡片条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_changelog_box"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在养绿植"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_total_plants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 盆"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/card_border"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="需浇水"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_water_due_plants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 盆"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/card_border"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="需施肥"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_stat_fert_due_plants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 盆"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 搜索栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search_plants"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_box"
            android:hint="🔍 搜索绿植名称、品种、摆放位置或养护要领..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true" />
    </FrameLayout>

    <!-- 光照与状态 Tab 过滤 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_plant_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_plant_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:checked="true"
                android:text="全部绿植"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_plant_water_due"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="💧 待浇水"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_plant_fert_due"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🌿 待施肥"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_plant_full_sun"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="☀️ 强光全日照"
                android:textSize="12sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_plant_semi_shade"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⛅ 散光半阴"
                android:textSize="12sp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 列表容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_plants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- 空态提示 -->
        <LinearLayout
            android:id="@+id/layout_plants_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前分类暂无绿植养护记录"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击右上角「➕ 添入绿植」建立水肥养护日历"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部关闭按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_plant_vault"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="关闭绿植舱"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:cornerRadius="10dp" />

</LinearLayout>
