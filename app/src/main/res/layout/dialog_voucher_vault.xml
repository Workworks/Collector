<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 1. 顶栏：标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🎟️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时效权益与卡券票据收纳馆"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优惠券、代金券、洗车/健身次卡与会员权益统一收纳"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_voucher_vault"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 2. 统计看板卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voucher_active_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 张"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="在手可用卡券"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voucher_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待享权益总值"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voucher_expiring_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 项"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3天内临期待用"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. 过滤 Tab 栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_voucher_active"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="有效可用"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_active"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_voucher_expiring"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⏰ 临期抢用"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_voucher_times_card"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎫 计次卡"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_voucher_history"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="📜 历史已核销"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 4. 列表滚动容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/voucher_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态注入卡券卡片 -->
        </LinearLayout>
    </ScrollView>

    <!-- 5. 底部操作按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_add_voucher"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="➕ 登记卡券 / 优惠权益 / 次卡"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

</LinearLayout>
