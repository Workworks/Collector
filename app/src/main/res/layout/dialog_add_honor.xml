<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_dialog_honor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 录入/编辑荣誉证书"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- 归属成员选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="归属家庭成员 *"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_honor_member_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_mem_self"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👤 本人"
                android:checked="true"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_mem_partner"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="💑 伴侣"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_mem_child"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👶 孩子"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_mem_parents"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👴 父母/长辈"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 荣誉类型选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="荣誉与资质类型 *"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_honor_cat_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_cat_career"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="💼 职业资格"
                android:checked="true"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_cat_degree"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🎓 学历学位"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_cat_exam"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🏅 考级认证"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_cat_competition"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🏆 竞赛奖状"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_edit_cat_medal"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🎖️ 勋章奖牌"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 证书名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="证书/荣誉名称 *"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_honor_title"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:hint="例如: 软件设计师 (中级) / 英皇钢琴八级 / 优秀员工"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 证书编号 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="证书编号 / 统一序列号"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_honor_cert_number"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:hint="例如: 2024098877665544"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 发证机构与成绩名次 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="颁发/发证机构"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_honor_issuer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:hint="如: 人社部/清华大学"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="成绩/等级/名次"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/primary"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_honor_score"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:hint="如: 优秀/一等奖"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 获得/发证日期 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="获得/发证日期 (点击选择) *"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btn_pick_honor_issue_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_honor_issue_date_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 选择获得发证时间"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更改 ➔"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- 有效期截止日 / 复审年审日期 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="有效期至 / 下次年审复审日期"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/btn_pick_honor_expiry_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_honor_expiry_date_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 设为终身有效 / 长期"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更改 ➔"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- 备注与成长故事 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="成长足迹与备注故事"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_honor_notes"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:gravity="top"
                android:hint="例如: 历时半年备考一次性高分通过 / 比赛现场发挥超常"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_add_honor"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="取消"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/card_border"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_honor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.5"
                android:text="💾 存入荣誉馆"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
