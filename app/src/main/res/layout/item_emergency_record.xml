<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_changelog_box"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 顶部徽章栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_emergency_kit_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 地震避险72h包"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_emergency_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔦 工具照明"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_emergency_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 待定期测试"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 物资名称与数量 -->
    <TextView
        android:id="@+id/item_emergency_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="手摇发电多波段收音机+强光手电"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- 存放位置 (黄金动线) -->
    <TextView
        android:id="@+id/item_emergency_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 存放位置: 玄关防盗门后收纳挂架"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 时效与轮换周期 -->
    <TextView
        android:id="@+id/item_emergency_expiry_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 时效状态: 长期耐用 · 建议每 6 个月测试自放电"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 使用要领与操作备忘 -->
    <TextView
        android:id="@+id/item_emergency_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 要领: 手摇发电 1 分钟可供照明 15 分钟"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="8dp" />

    <!-- 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_check_emergency"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="✅ 点检演练打卡"
            android:textSize="11sp"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_item_edit_emergency"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary"
            android:contentDescription="编辑" />

        <ImageButton
            android:id="@+id/btn_item_delete_emergency"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/danger"
            android:contentDescription="删除" />
    </LinearLayout>

</LinearLayout>
