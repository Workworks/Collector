<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- 房间颜色标识圆点与图标 -->
    <TextView
        android:id="@+id/room_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="🛋️"
        android:textSize="18sp"
        android:background="@drawable/bg_icon_circle"
        android:layout_marginEnd="10dp" />

    <!-- 房间名称与物品数量提示 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="客厅"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/room_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="存放 3 件物品"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 编辑按钮 -->
    <ImageButton
        android:id="@+id/btn_edit_room"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/primary"
        android:contentDescription="编辑"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp" />

    <!-- 上移按钮 -->
    <ImageButton
        android:id="@+id/btn_move_up"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_arrow_up"
        android:contentDescription="上移"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp" />

    <!-- 下移按钮 -->
    <ImageButton
        android:id="@+id/btn_move_down"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_arrow_down"
        android:contentDescription="下移"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp" />

    <!-- 删除按钮 -->
    <ImageButton
        android:id="@+id/btn_delete_room"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/danger"
        android:contentDescription="删除"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp" />

</LinearLayout>
