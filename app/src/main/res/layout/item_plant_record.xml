<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_changelog_box"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 顶部徽章栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_plant_light_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛅ 散光半阴"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_plant_species_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="龟背竹"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_plant_water_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 需浇水"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/item_plant_fert_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌿 需施肥"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 绿植名称 -->
    <TextView
        android:id="@+id/item_plant_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="南阳台龟背竹"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- 摆放位置 -->
    <TextView
        android:id="@+id/item_plant_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 摆放位置: 南阳台花架 #02"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 浇水与施肥排期 -->
    <TextView
        android:id="@+id/item_plant_schedule_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💧 浇水: 每 7 天 (下次: 2026-08-22) · 🌿 施肥: 每 30 天"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 养护要领 -->
    <TextView
        android:id="@+id/item_plant_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 要领: 表土干透浇透，夏季早晚喷雾"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="8dp" />

    <!-- 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_water_plant"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="💧 浇水打卡"
            android:textSize="11sp"
            android:textColor="@color/accent_blue"
            app:strokeColor="@color/accent_blue"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_fert_plant"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="🌿 施肥打卡"
            android:textSize="11sp"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_item_edit_plant"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary"
            android:contentDescription="编辑" />

        <ImageButton
            android:id="@+id/btn_item_delete_plant"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/danger"
            android:contentDescription="删除" />
    </LinearLayout>

</LinearLayout>
