<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:backgroundTint="@color/background"
    android:padding="18dp">

    <!-- 顶部标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 功能全景与使用教程"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="掌握空间寻物、收纳扫码、折旧与多端同步"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_tutorial"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_close"
            android:padding="7dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 分类过滤 Chip 栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/tutorial_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_tut_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🌟 全部教程"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_tut_spatial"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🗺️ 空间与收纳扫码"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_tut_asset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="📉 折旧与保质期"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_tut_photo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="📸 照片与发票"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_tut_sync"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="☁️ 小组件与云同步"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 教程列表 ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/tutorial_cards_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- 教程卡片动态装载 -->

        </LinearLayout>
    </ScrollView>

    <!-- 底部关闭/开始使用按钮 -->
    <Button
        android:id="@+id/btn_tutorial_got_it"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="🚀 我学会了 · 开始使用"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_primary"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
