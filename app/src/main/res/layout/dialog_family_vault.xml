<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 1. 顶栏：标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🪪"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="家庭多成员证照安全夹"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="身份证、护照、户口本、结婚证、房产证与防盗流水印"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_family_vault"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 2. 家庭成员 Filter Tab 栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_member_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="全部成员"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_active"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_member_self"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👨 本人"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_member_partner"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👩 伴侣"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_member_child"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👶 孩子"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_member_parents"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👴 父母长辈"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 证件列表滚动容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/family_vault_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态注入证照卡片 -->
        </LinearLayout>
    </ScrollView>

    <!-- 4. 底部操作按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_add_identity_doc"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="➕ 登记家庭成员证照"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

</LinearLayout>
