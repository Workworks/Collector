<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_changelog_box"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 顶部徽章栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_wardrobe_season_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍂 冬季"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_wardrobe_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧥 外套羽绒"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_wardrobe_sealed_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 换季封存中"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_wardrobe_sleeping_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 沉睡未穿 (180+天)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 单品名称 -->
    <TextView
        android:id="@+id/item_wardrobe_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="波司登极寒鹅绒羽绒服"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- 材质与面料 / 颜色 -->
    <TextView
        android:id="@+id/item_wardrobe_material"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎨 颜色/面料: 米白色 · 90%白鹅绒 蓬松度800+"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 收纳存放位置 -->
    <TextView
        android:id="@+id/item_wardrobe_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 收纳位置: 主卧大衣柜上层 · 真空压缩袋 #03"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="3dp" />

    <!-- 洗护备忘 -->
    <TextView
        android:id="@+id/item_wardrobe_care"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧺 洗护: 仅限专业干洗 · 不可烘干"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="6dp" />

    <!-- 成本与穿着打卡数据条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip_inactive"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/item_wardrobe_cost_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💰 购入: ¥1299.00 · 穿着 14 次 · 每次 ¥92.79"
            android:textSize="11sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_wear_checkin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="✨ 穿搭打卡"
            android:textSize="11sp"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_toggle_seal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="📦 封箱换季"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_item_edit_wardrobe"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary"
            android:contentDescription="编辑" />

        <ImageButton
            android:id="@+id/btn_item_delete_wardrobe"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/danger"
            android:contentDescription="删除" />
    </LinearLayout>

</LinearLayout>
