<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 弹窗顶栏：图标徽章 + 标题 + 轨迹按钮 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/dialog_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                app:tint="#FFFFFFFF"
                android:contentDescription="图标" />
        </FrameLayout>

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="记一笔"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btn_view_location_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 位置轨迹"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_inactive"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dialog_close_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 增加 / 减少 模式切换 (默认增加/入库) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeBuy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="➕ 增加 / 购入"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:checked="true"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeUse"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="➖ 减少 / 消耗"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 分类选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🏷️ 选择分类"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/dialog_category_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- 物品/品牌名称 (独立清爽输入框) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📦 物品 / 品牌名称"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <AutoCompleteTextView
                android:id="@+id/brandInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_box"
                android:hint="例如：好奇小森林、房门钥匙、身份证"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:maxLines="1"
                android:completionThreshold="1" />

            <!-- 数量与单位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔢 数量与单位"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单位可自定"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/minusBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:text="−"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <EditText
                    android:id="@+id/qtyInput"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="6"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/plusBtn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:text="+"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <AutoCompleteTextView
                    android:id="@+id/unitDropdown"
                    android:layout_width="86dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:inputType="text"
                    android:text="片"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>

            <!-- 快捷数量药丸 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/quick1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="1"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quick10"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="10"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quick20"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="20"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quick50"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="50"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quick100"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="14dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="100"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 📍 空间与放置位置 (选填/支持平面图定位) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 空间与放置位置（选填）"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_select_on_map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ 平面图点位"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <AutoCompleteTextView
                    android:id="@+id/houseDropdown"
                    android:layout_width="110dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:inputType="none"
                    android:text="🏠 自己的家"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="6dp" />

                <AutoCompleteTextView
                    android:id="@+id/locationInput"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="如：主卧衣柜二层、玄关柜"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:inputType="text"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- 常用房间快速填入药丸 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginTop="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/room_chip_entry"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:text="🚪 玄关"
                        android:clickable="true" />

                    <TextView
                        android:id="@+id/room_chip_living"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:text="🛋️ 客厅"
                        android:clickable="true" />

                    <TextView
                        android:id="@+id/room_chip_bedroom"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:text="🛏️ 主卧"
                        android:clickable="true" />

                    <TextView
                        android:id="@+id/room_chip_kitchen"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:text="🍳 厨房"
                        android:clickable="true" />

                    <TextView
                        android:id="@+id/room_chip_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:text="📦 储物间"
                        android:clickable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ⭐ 重要物品防丢标记与订阅提醒 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/cb_is_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 设为重要贵重物品（钥匙/证件/存单）"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_subscription_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏰ 订阅定期位置核对提醒："
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/sub_interval_1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_active"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每天"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_3"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每3天"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_7"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每周"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_30"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每月"
                            android:clickable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 金额/价格输入模式切换 -->
            <LinearLayout
                android:id="@+id/price_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/price_mode_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💰 实付总金额（元，可选）"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_toggle_price_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 切换为按单价输入"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <EditText
                    android:id="@+id/priceInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:hint="例如：120.00 (出库可不填)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 备注信息 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📝 备注信息（可选）"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_box"
                android:hint="例如：618自营购入、放次卧衣柜"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp" />

            <!-- 实时换算与单价/总价计算明细预览条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/amountPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本次入库：+ 1 片"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作双按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_btn_secondary"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:text="确认添加"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>