<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 弹窗顶栏：图标徽章 + 标题 + 轨迹按钮 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/dialog_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                app:tint="#FFFFFFFF"
                android:contentDescription="图标" />
        </FrameLayout>

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="记一笔"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btn_view_location_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 位置轨迹"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_chip_inactive"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dialog_close_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 增加 / 减少 模式切换 (默认增加/入库) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeBuy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="➕ 增加 / 购入"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:checked="true"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeUse"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="➖ 减少 / 消耗"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 分类选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🏷️ 分类"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_spinner"
                android:paddingHorizontal="12dp" />

            <!-- 品牌 / 物品名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📦 品牌 / 物品名称 *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/brandInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_box"
                android:hint="例如：联想拯救者Y9000X、戴森吹风机"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp" />

            <!-- 数量与单位输入行 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🔢 数量与单位 *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_step_dec"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <EditText
                    android:id="@+id/qtyInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:hint="数量"
                    android:text="1"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_step_inc"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stepper_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <EditText
                    android:id="@+id/unitInput"
                    android:layout_width="68dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:hint="单位"
                    android:text="件"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 1. 购入日期与折旧估值 (用于计算拥有天数和日均花费) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 购入时间与折旧估值（计算拥有天数与日均花费）"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/btn_pick_purchase_date"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:text="📅 购入: 2026-08-19 (1天)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/input_current_valuation"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_box"
                        android:hint="当前估值: 如3500"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="10dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 空间与放置位置 (带平面图选点与常用房间) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📍 放置位置与空间（选填）"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_open_floorplan_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗺️ 平面图打点"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/houseSpinner"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="8dp" />

                    <EditText
                        android:id="@+id/locationInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="如: 主卧衣柜二层抽屉"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="12dp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 常用房间快捷标签 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/room_chip_hall"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="🚪 玄关"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/room_chip_living"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="🛋️ 客厅"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/room_chip_bedroom"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="🛏️ 主卧"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/room_chip_kitchen"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="🍳 厨房"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/room_chip_storage"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:paddingHorizontal="10dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="📦 储物间"
                            android:clickable="true" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 3. 退役与待办归置 (挂闲鱼/转转/赠送/回收) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cb_is_retired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 设置为此物品已退役 / 待办归置"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:buttonTint="#EF4444" />

                <LinearLayout
                    android:id="@+id/layout_retire_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinner_retire_action"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingHorizontal="8dp" />

                    <EditText
                        android:id="@+id/input_retire_sold_price_edit"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="出二手实际回血金额 (元，选填)"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="10dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 周期按月/按年订阅资产体系 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cb_is_subscription_asset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 设为周期订阅资产（iCloud/会员/宽带/车险）"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:buttonTint="#3B82F6" />

                <LinearLayout
                    android:id="@+id/layout_sub_asset_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinner_sub_cycle"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_spinner"
                            android:paddingHorizontal="8dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/btn_pick_next_billing_date"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/bg_chip_inactive"
                            android:gravity="center"
                            android:text="下次扣费: 2026-09-01"
                            android:textSize="11sp"
                            android:textColor="@color/primary"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ⭐ 重要物品防丢标记与订阅提醒 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cb_is_important"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 设为重要贵重物品（钥匙/证件/存单）"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary" />

                <LinearLayout
                    android:id="@+id/layout_subscription_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏰ 订阅定期位置核对提醒："
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/sub_interval_1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_active"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每天"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_3"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每3天"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_7"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每周"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/sub_interval_30"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:text="每月"
                            android:clickable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 金额/价格输入模式切换 -->
            <LinearLayout
                android:id="@+id/price_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/price_mode_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💰 购入金额 / 订阅价格（元）"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_toggle_price_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 切换为按单价输入"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <EditText
                    android:id="@+id/priceInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:hint="例如：5500.00"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 备注信息 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📝 备注信息（可选）"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input_box"
                android:hint="例如：京东自营购入、放次卧衣柜"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="14dp"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="13sp" />

            <!-- 实时换算与单价/总价计算明细预览条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_changelog_box"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/amountPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本次入库：+ 1 件"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作双按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_btn_secondary"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:text="确认保存"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>