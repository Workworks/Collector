<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐙 配置 GitHub 仓库源"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="用于应用检查最新版本与下载热更新安装包 (owner/repo)"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/input_repo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_box"
        android:hint="例如: Workworks/Collector"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="14dp"
        android:textSize="14sp"
        android:inputType="textUri"
        android:maxLines="1" />

    <!-- 快捷恢复默认按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btn_restore_default_repo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 恢复默认源 (Workworks/Collector)"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_repo"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_btn_secondary"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_save_repo"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="保存配置"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
