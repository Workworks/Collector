<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏：图标 + 套装名称 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_kit_checklist_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="📸"
            android:background="@drawable/bg_icon_circle_soft" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_kit_checklist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="摄影外拍套装 · 打包核对"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_kit_checklist_progress_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="装箱进度：0/0 项 (0%)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_checklist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 动态进度条 -->
    <ProgressBar
        android:id="@+id/pb_kit_checklist"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_track"
        android:layout_marginBottom="14dp" />

    <!-- 待核对物品列表滚动区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_checklist_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 底部按钮：扫码装箱 + 完成核对 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_all_checked"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary"
            android:text="🎉 完成装箱打卡"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
