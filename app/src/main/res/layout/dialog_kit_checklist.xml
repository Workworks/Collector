<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏：图标 + 套装名称 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_kit_checklist_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="🎒"
            android:background="@drawable/bg_icon_circle_soft" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_kit_checklist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="出行装备套装 · 装箱核对"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_kit_checklist_progress_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="装箱进度：0/0 项 (0%)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_checklist"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 模式切换栏 (🛫 出发装箱 / 🏨 返程清点) + 导出海报 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group_checklist_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_depart"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🛫 出发装箱"
                android:textSize="11sp"
                android:paddingHorizontal="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_return"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🏨 返程清点"
                android:textSize="11sp"
                android:paddingHorizontal="6dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_packing_poster"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📜 导出清单海报"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- 动态进度条 -->
    <ProgressBar
        android:id="@+id/pb_kit_checklist"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_track"
        android:layout_marginBottom="14dp" />

    <!-- 待核对物品列表滚动区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_checklist_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 底部按钮：完成打卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_all_checked"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="完成装箱打卡"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_primary"
            android:backgroundTint="@color/primary" />
    </LinearLayout>

</LinearLayout>
