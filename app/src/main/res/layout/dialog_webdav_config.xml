<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶部标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☁️ WebDAV 私有云同步"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_close_webdav"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="支持坚果云、Nextcloud、群晖 Synology 等标准 WebDAV 私有网盘，实现多端无缝备份与还原。"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <!-- 1. WebDAV 服务器地址 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WebDAV 服务器 URL"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_webdav_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_box"
        android:hint="如：https://dav.jianguoyun.com/dav/"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="12dp"
        android:inputType="textUri"
        android:textSize="13sp" />

    <!-- 2. 用户名 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="用户名 / 账号邮箱"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_webdav_user"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_box"
        android:hint="账号用户名或邮箱"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="12dp"
        android:inputType="textEmailAddress"
        android:textSize="13sp" />

    <!-- 3. 应用独立密码 / Token -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="应用独立密码 / 授权 Token"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_webdav_pass"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_box"
        android:hint="坚果云等网盘生成的第三方应用独立密码"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="12dp"
        android:inputType="textPassword"
        android:textSize="13sp" />

    <!-- 操作按钮组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn_test_webdav"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🔌 测试连接"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_save_webdav_config"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="💾 保存配置"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_upload_to_webdav"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="☁️ 上传备份到云端"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_btn_custom_add"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_download_from_webdav"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="📥 从云端恢复数据"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F59E0B"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
