<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏：标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_add_digital_emoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="📷"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_add_digital_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="登记数字相册 / 电子资产"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_close_add_digital"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 数字资产形态类型选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="资产类型形态："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_digital_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_type_album"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📷 相册集"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_software"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔑 软件Key"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_domain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌐 域名/网站"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_doc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📚 资料包"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- 2. 名称与容量 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数字资产名称与容量/张数："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_digital_name"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.6"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="如：2025 全家福精选相册"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_digital_size"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="如：128 GB"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 3. 云盘/本地访问路径 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="存储路径 / 网盘访问链接："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_digital_url"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="如：https://pan.baidu.com/... 或 NAS路径"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- 4. 激活码 / 授权Key / 账号凭证 (选填) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授权 Key / 激活码 / 凭证 (选填)："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_digital_key"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="支持一键复制，敏感信息请妥善保存"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- 5. 备份健康度状态 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多端备份状态："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_bak_synced"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 已备份云端/NAS"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/success" />

                <RadioButton
                    android:id="@+id/rb_bak_local"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟡 仅本地单点"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rb_bak_unbacked"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 未备份预警"
                    android:textSize="12sp"
                    android:textColor="@color/danger" />
            </RadioGroup>

            <!-- 6. 价值原价与备注 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="购买/获取价格 (元，无花费可填0)："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_digital_price"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="0.00"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:singleLine="true" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_add_digital"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_add_digital"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="💾 保存数字资产"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
