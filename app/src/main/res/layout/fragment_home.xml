<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶部应用标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/background">

        <!-- 多账本切换器 -->
        <LinearLayout
            android:id="@+id/layout_ledger_switcher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tv_home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 个人资产"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ▾"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 局域网极速互传 -->
        <ImageView
            android:id="@+id/btn_lan_sync_top"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_share"
            app:tint="@color/primary"
            android:contentDescription="局域网互传"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 智能扫码按钮 (扫收纳箱/条形码) -->
        <ImageView
            android:id="@+id/btn_scan_qr_top"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary"
            android:contentDescription="智能扫码"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 空间平面图快捷键 -->
        <ImageView
            android:id="@+id/btn_open_floorplan_top"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_primary"
            android:contentDescription="空间平面图"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 实物大盘点快捷键 -->
        <ImageView
            android:id="@+id/btn_inventory_audit_top"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_nav_report"
            app:tint="@color/accent_dark"
            android:contentDescription="实物大盘点"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 搜索按钮 -->
        <ImageView
            android:id="@+id/btn_search_items"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_sort"
            app:tint="@color/text_primary"
            android:contentDescription="搜索"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 顶部快速新增 -->
        <ImageView
            android:id="@+id/btn_top_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary"
            android:contentDescription="快速新增"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="90dp">

            <!-- 物品 / 订阅 药丸胶囊分段选择器 -->
            <LinearLayout
                android:layout_width="168dp"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="@color/input_bg"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- 物品 Tab -->
                <TextView
                    android:id="@+id/tab_items"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="物品"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 订阅 Tab -->
                <TextView
                    android:id="@+id/tab_subs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="订阅"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 建议备份数据提示卡片 (可关闭) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_backup_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/primary_surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚠️ 建议尽快备份数据"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <ImageView
                            android:id="@+id/btn_close_backup_banner"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/text_secondary"
                            android:contentDescription="关闭"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="将打开数据管理并生成本地 JSON 备份包，保障收纳数据安全。"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/btn_remind_later"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 天后再提醒"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="8dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btn_backup_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="立即备份"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_chip_active"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 耗材安全库存预警与智能采购清单卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_low_stock_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/accent_surface_stroke"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_low_stock_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚠️ 耗材安全库存告急 (3 项需补货)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_dark" />

                        <TextView
                            android:id="@+id/btn_generate_replenishment_list"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛒 一键生成采购单"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_chip_active"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_low_stock_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="咖啡豆、抽纸等日常耗材已低于预设安全库存线，点击即可复制格式化采购单直发微信或购物平台。"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 重要物品防丢核对卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_important_vip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/accent_surface_stroke"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ 贵重物品防丢 · 定期核对"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_dark" />

                        <TextView
                            android:id="@+id/vip_items_count_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 件重要关注"
                            android:textSize="12sp"
                            android:textColor="@color/accent" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vip_items_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 【物品模式】我的资产总卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_my_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的资产"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />

                        <!-- 在役 / 退役数量胶囊 -->
                        <TextView
                            android:id="@+id/tv_active_retired_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:backgroundTint="@color/input_bg"
                            android:text="1 在役 / 0 退役"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tv_total_asset_amount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="¥6,999.00"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-black" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="日均消费"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_total_daily_cost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¥3.65"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 【订阅模式】我的订阅总卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_my_subscriptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="我的订阅资产"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_active_subs_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:backgroundTint="@color/input_bg"
                            android:text="0 项活跃订阅"
                            android:textSize="12sp"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_monthly_sub_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¥0.00"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="月度订阅总支出"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="年化总预算"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_annual_sub_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¥0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 筛选与排序按钮栏 (全部 ▾ / 排序 ▾ / 全部分类 ▾ / 筛选图标) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- 状态筛选 (全部 / 在役 / 已退役) -->
                <TextView
                    android:id="@+id/btn_filter_status"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="@color/input_bg"
                    android:text="全部 ▾"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- 排序方式 (按天数 / 按价值 / 按日均) -->
                <TextView
                    android:id="@+id/btn_filter_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="@color/input_bg"
                    android:text="排序 ▾"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- 全部分类下拉 -->
                <TextView
                    android:id="@+id/btn_filter_category"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="@color/input_bg"
                    android:text="全部分类 ▾"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- 空间平面图快捷入口 -->
                <ImageView
                    android:id="@+id/btn_filter_map_view"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="@color/input_bg"
                    android:src="@drawable/ic_sort"
                    app:tint="@color/text_primary"
                    android:contentDescription="更多筛选"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 物品/订阅卡片列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_asset_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 空状态提示 -->
            <LinearLayout
                android:id="@+id/layout_empty_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="48dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="42sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无物品记录\n点击下方 + 开始记一笔"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>