<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:backgroundTint="@color/card"
    android:padding="18dp">

    <!-- 顶部高定日历标题展示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_picker_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 选择日期"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_selected_date_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2022年 8月1日 星期一"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_selected_date_relative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距今 1478 天前"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_picker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 快捷标签横向滑动栏 (今天 / 昨天 / 1年前 / 2年前 / 3年前 / 5年前 等) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/quick_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_today"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="今天"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_yesterday"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="昨天"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_1_month_ago"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="1个月前"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_1_year_ago"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="1年前"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_2_years_ago"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="2年前"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_3_years_ago"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="3年前"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_5_years_ago"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="5年前"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 年份 / 月份快捷选择器与前后步进切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="上个月" />

        <!-- 年份快捷切换按钮 (点击展开年份网格) -->
        <TextView
            android:id="@+id/btn_select_year"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2022 年 ▼"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip_inactive"
            android:layout_marginHorizontal="4dp" />

        <!-- 月份快捷切换按钮 (点击展开月份网格) -->
        <TextView
            android:id="@+id/btn_select_month"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="8 月 ▼"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip_inactive"
            android:layout_marginHorizontal="4dp" />

        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="下个月" />
    </LinearLayout>

    <!-- 视图切换容器 (日历网格 / 年份快捷网格 / 月份快捷网格) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- 1. 正常日历视图 (含星期标头 + 42天网格) -->
        <LinearLayout
            android:id="@+id/layout_calendar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 星期表头 (一 二 三 四 五 六 日) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:columnCount="7"
                android:rowCount="1">

                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="一" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="二" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="三" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="四" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="五" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="六" android:textSize="12sp" android:textColor="@color/primary" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:gravity="center" android:text="日" android:textSize="12sp" android:textColor="@color/primary" android:textStyle="bold" />
            </GridLayout>

            <!-- 日期网格 (动态填充 7 列 x 6 行) -->
            <GridLayout
                android:id="@+id/grid_days"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="7"
                android:rowCount="6"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 2. 年份快捷网格视图 (1990 ~ 2035，可快速滑动点击) -->
        <ScrollView
            android:id="@+id/layout_year_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:overScrollMode="never">

            <GridLayout
                android:id="@+id/grid_years"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:padding="4dp" />
        </ScrollView>

        <!-- 3. 月份快捷网格视图 (1月 ~ 12月) -->
        <GridLayout
            android:id="@+id/layout_month_picker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="3"
            android:rowCount="4"
            android:visibility="gone"
            android:padding="8dp" />

    </FrameLayout>

    <!-- 底部操作按钮 (取消 / 确认选择) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_picker_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_picker_confirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:layout_marginStart="6dp"
            android:text="确定选择 (2022-08-01)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
