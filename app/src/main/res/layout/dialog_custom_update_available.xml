<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 头部图标与版本徽章 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                app:tint="@color/white"
                android:contentDescription="新版本" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发现新版本"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/custom_version_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.2.5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/custom_update_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8 MB"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/custom_update_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最新发布"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ 本次更新特性说明："
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- 滚动日志卡片 (限定高度，内部顺畅滚动，永不挤占底部按钮) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_changelog_box"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/custom_update_changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="更新日志内容"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <!-- 热补丁专属高亮提示条 (存在热补丁时显示) -->
    <LinearLayout
        android:id="@+id/layout_hot_patch_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_inactive"
        android:backgroundTint="@color/tint_subtle_emerald"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_hot_patch_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="检测到增量热补丁，体积小且免重新安装，即点即用！"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- 底部操作按钮：支持优先热更新与全量升级 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 优先热更新按钮 (当可用时高亮显示) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/custom_btn_hot_patch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ 极速免重装热更新 (推荐)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_btn_cancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="稍后提醒"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/card_border"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_btn_update"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.6"
                android:text="🚀 全量 APK 更新"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_dark"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
