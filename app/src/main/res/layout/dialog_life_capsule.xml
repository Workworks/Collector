<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 1. 顶栏：标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🎞️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_capsule_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="索尼 A7M4 相机"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_capsule_item_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时光胶囊与生活画册回忆录"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_capsule"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 2. 陪伴统计与真香指数卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_capsule_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ 陪伴 328 天"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_capsule_daily_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 日均成本 ￥18.2 / 天"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/card_border"
                android:layout_marginHorizontal="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_capsule_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 5.0 真香满分"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tv_capsule_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="共 4 个时光里程碑"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. 时光回忆列表容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/capsule_timeline_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 动态填充时光回忆卡片 -->
        </LinearLayout>
    </ScrollView>

    <!-- 4. 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_capsule_poster"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="🎨 导出画册长图"
            android:textSize="13sp"
            android:textColor="@color/primary"
            app:strokeColor="@color/primary"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_memory_moment"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:text="➕ 记录新瞬间"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
