<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_changelog_box"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 顶部归属成员与类型徽章 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/item_honor_member_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 本人"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_honor_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💼 职业资格"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_honor_score_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="优秀"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:background="@drawable/bg_chip_inactive"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/item_honor_expiry_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 临近年审"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 证书荣誉名称 -->
    <TextView
        android:id="@+id/item_honor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="软件设计师 (中级职称)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- 证书编号 (支持脱敏与一键复制) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/item_honor_cert_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="编号: 202409********8899"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_copy_cert_number"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📋 复制完整编号"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

    <!-- 发证机构与日期 -->
    <TextView
        android:id="@+id/item_honor_issuer_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏛️ 发证: 人力资源和社会保障部  ·  📅 获得: 2024-05-20"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="4dp" />

    <!-- 备注足迹故事 -->
    <TextView
        android:id="@+id/item_honor_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 历时半年备战，一次性高分通过"
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- 底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/item_honor_validity_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🟢 终身有效"
            android:textSize="11sp"
            android:textColor="@color/primary" />

        <ImageButton
            android:id="@+id/btn_item_delete_honor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_hint"
            android:contentDescription="移出荣誉" />
    </LinearLayout>

</LinearLayout>
