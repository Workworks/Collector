<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🎟️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_add_voucher_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登记时效卡券与权益"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优惠券、代金券、洗车/健身次卡、会员每月专属权益"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_add_voucher"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 卡券名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卡券/权益名称："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_voucher_title"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="如：美团外卖满30减10、途虎洗车次卡"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- 2. 卡券类型 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权益类型："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_voucher_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_type_coupon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="满减券"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_times_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="计次卡"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_cash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="代金券"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_type_privilege"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="会员权益"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- 3. 面额与门槛 / 次数 -->
            <LinearLayout
                android:id="@+id/layout_amount_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tv_voucher_val_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="减免面额 (元)："
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_voucher_value"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_box"
                        android:paddingHorizontal="12dp"
                        android:hint="如 10.0"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_voucher_min_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用门槛 (满X可用)："
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_voucher_min_spend"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_box"
                        android:paddingHorizontal="12dp"
                        android:hint="无门槛填0"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- 次卡总次数与剩余次数设置 (仅次卡显示) -->
            <LinearLayout
                android:id="@+id/layout_times_card_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_voucher_total_times"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="总次数 (如 10)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/et_voucher_remaining_times"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="剩余次数 (如 5)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="number" />
            </LinearLayout>

            <!-- 4. 到期时间 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="到期截止日期："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_voucher_expiry_picker"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:text="📅 点击选择到期日 (默认30天后)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- 5. 券码 / 核销码与适用平台 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="核销码 / 券码与适用平台："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_voucher_code"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="核销码/券码 (选填)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/et_voucher_platform"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="如 美团/京东"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 6. 备注说明 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用规则与备注："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_voucher_notes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_input_box"
                android:padding="10dp"
                android:gravity="top|start"
                android:hint="如：限周一至周五午市可用，不可与其他优惠同享..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textMultiLine" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_voucher"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_voucher"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="🎟️ 保存卡券权益"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
