<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🏆"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全家荣誉与成长履历馆"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="学历职业资质 · 竞赛奖状考级 · 人生足迹长卷"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_honor"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="➕ 录入荣誉"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 快捷生成长卷横幅 -->
    <LinearLayout
        android:id="@+id/btn_generate_timeline_poster"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_inactive"
        android:backgroundTint="#1510B981"
        android:paddingHorizontal="14dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一键生成「全家成长足迹与高光成就长卷」"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="绘制导出 ➔"
            android:textSize="11sp"
            android:textColor="@color/primary" />
    </LinearLayout>

    <!-- 成员选择器横向滑动条 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_honor_members"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_member_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👨‍👩‍👧 全家成员"
                android:checked="true"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_member_self"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👤 本人"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_member_partner"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="💑 伴侣"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_member_child"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👶 孩子"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_member_parents"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="👴 父母/长辈"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/bg_chip_selector" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 分类选择器横向滑动条 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_honor_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="📑 全部类型"
                android:checked="true"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_degree"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎓 学历学位"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_career"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="💼 职业资格"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_exam"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🏅 考级认证"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_competition"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🏆 竞赛奖状"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_medal"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎖️ 勋章奖牌"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/bg_chip_selector" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 搜索输入框 -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusBottomEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusTopStart="10dp"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_honor"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:hint="🔍 搜索证书名称、发证机关或编号..."
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 列表容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="310dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_honors"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_honor_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆"
                android:textSize="40sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无该分类荣誉证书"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击上方「➕ 录入荣誉」记录全家高光成就"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部关闭按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_honor_vault"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="完成退出"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        app:strokeColor="@color/card_border"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
