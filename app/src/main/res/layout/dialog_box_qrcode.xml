<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="18dp">

    <!-- 顶栏标题与关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_qr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏷️ 收纳箱专属二维码标签"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_close_qr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 标签打印预览卡片 (可作为整张图片导出或打印) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_qr_label_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="18dp">

            <!-- 空间与收纳箱/房间名称 -->
            <TextView
                android:id="@+id/tv_qr_box_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 主卧衣柜 · 2号收纳箱"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_qr_box_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🏠 自己的家 · 共 5 件在库物品"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <!-- 二维码图片展示 (220dp x 220dp) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="收纳箱二维码" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部说明与 App Logo 标识 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 使用 Collecter 扫一扫 · 秒查箱内清单"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 硬件生态拓展按钮组 (蓝牙热敏打印机 / NFC 智能贴纸) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_bluetooth_print"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🖨️ 蓝牙标签机打印"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_nfc_write"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🏷️ 写入 NFC 贴纸"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent_dark"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- 操作按钮组 (保存至相册 / 一键分享打印) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_save_qr_to_gallery"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="💾 保存到相册"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_chip_inactive"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btn_share_qr_label"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="📤 分享/打印标签"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_btn_primary"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
