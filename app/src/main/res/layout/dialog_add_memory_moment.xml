<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_moment_dialog_emoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="✨"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_moment_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="记录生活高光回忆"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_close_moment_input"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 事件标题与氛围 Emoji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回忆事件标题："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_moment_emoji"
                    android:layout_width="50dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:text="✨"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_moment_title"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="如：带它登顶泰山看日出"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 2. 发生日期选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发生日期："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_moment_date_picker"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:text="📅 2026-08-20"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- 3. 真香/心动评分 (1~5 星) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="心动 / 真香体验评分："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_moment_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rb_star_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★1"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rb_star_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★2"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rb_star_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★3"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rb_star_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★4"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rb_star_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★5 真香"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </RadioGroup>

            <!-- 4. 文字回忆故事随笔 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="故事随笔 / 使用心得："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_moment_story"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input_box"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="记录当时的感动、使用体验或难忘的故事..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp" />

            <!-- 5. 故事照片留存 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="故事现场实拍照片："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_moment_photo_preview"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_input_box"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_scan_qr"
                    android:padding="18dp"
                    app:tint="@color/text_secondary"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_choose_moment_photo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="📷 选择实拍照片"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:id="@+id/tv_moment_photo_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持相册选择或拍照"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部确认操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_moment"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_moment"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="✨ 保存回忆"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
