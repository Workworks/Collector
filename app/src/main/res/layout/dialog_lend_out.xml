<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- 顶栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="📤"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle_soft"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_lend_out_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登记物品外借"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_lend_out_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前物品: 索尼 A7M4 相机"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_lend_out"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 借用人姓名与联系电话 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借用人姓名 / 称呼："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_borrower_name"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="如：老王、张三、表弟"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_borrower_contact"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="12dp"
                    android:hint="手机号 / 微信号 (选填)"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 2. 借出日期 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借出交接日期："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_lent_date_picker"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:text="📅 2026-08-20 (今日)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- 3. 约定归还日期 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="约定归还期限："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rg_return_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <RadioButton
                    android:id="@+id/rb_period_7d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="7天后"
                    android:checked="true"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_period_15d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15天后"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_period_1m"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1个月后"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_period_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="自定义日期"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_custom_return_date"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:text="📅 点击设定归还日期: 2026-08-27"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp" />

            <!-- 4. 押金金额 (选填) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="押金 / 租金 (元，无押金填0)："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_lending_deposit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="12dp"
                android:hint="0.00"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="numberDecimal"
                android:layout_marginBottom="12dp" />

            <!-- 5. 借出配件清单与交接备注 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="借出配件清单 / 交接说明："
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_lending_notes"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/bg_input_box"
                android:padding="12dp"
                android:gravity="top|start"
                android:hint="如：附带原装充电器、电池x2、128G 存储卡及保护相机包..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textMultiLine" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_lend_out"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/card_border"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_lend_out"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:text="📤 确认登记借出"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
